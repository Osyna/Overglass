# Run vhs demo.tape after installing this checkout.

Output assets/demo.gif

Require wof

Set Shell "bash"
Set FontSize 22
Set Width 1200
Set Height 640
Set Padding 20
Set Margin 30
Set MarginFill "#1e1b2e"
Set BorderRadius 10
Set Theme "Catppuccin Mocha"
Set TypingSpeed 60ms

Hide
Type "clear"
Enter
Show

Type "wof --help"
Sleep 400ms
Enter
Sleep 2.5s
Type "wof overlay --help"
Sleep 400ms
Enter
Sleep 1.5s
Type "wof remote --help"
Sleep 400ms
Enter
Sleep 5s

Sleep 3s
